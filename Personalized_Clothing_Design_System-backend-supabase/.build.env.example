# 可选：默认目标项目（也可通过命令行传入 project_ref）
SUPABASE_PROJECT_REF=sgovsejqrtznvnyuyesr

# 能力开关：1 开启，0 关闭
ENABLE_SUPABASE_LINK=1
ENABLE_DB_PUSH=1
ENABLE_DB_RESET=1
ENABLE_DEPLOY_FUNCTION=1
ENABLE_DEPLOY_ALL_FUNCTIONS=1
ENABLE_TEST_FUNCTION=1
ENABLE_SYNC_BRANCH=1
# sync-branch 需要 Supabase Branching（Pro 及以上）

# 可选：允许的函数白名单，逗号分隔；留空表示不限制
# FUNCTION_ALLOWLIST=auth-api,profile-api
