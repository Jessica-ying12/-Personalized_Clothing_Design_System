{
	"name": "pcds-admin",
	"type": "module",
	"version": "1.20.0",
	"private": true,
	"engines": {
		"node": ">=18.0.0"
	},
	"scripts": {
		"dev": "vite",
		"dev:host": "vite --host",
		"build": "run-p type-check \"build:only {@}\" --",
		"build:only": "vite build",
		"build:analyzer": "vite-bundle-visualizer -t sunburst",
		"build:check": "run-s libs:reload build lint type-check format test:e2e test:unit",
		"preview": "vite build && echo '' && vite preview --port 4173 --host",
		"preview:only": "vite preview --port 4173 --host",
		"test:unit": "vitest run",
		"test:e2e": "start-server-and-test preview http://localhost:4173 'cypress run --e2e'",
		"test:e2e:dev": "start-server-and-test 'vite dev --port 4173' http://localhost:4173 'cypress open --e2e'",
		"type-check": "vue-tsc --build --force",
		"lint": "eslint . --fix",
		"format": "prettier --write src/",
		"lint-type-format": "run-s lint type-check format",
		"design-tokens": "node scripts/tokens-tool.js",
		"libs:check": "taze",
		"libs:reload": "rm -rf node_modules package-lock.json && npm install"
	},
	"dependencies": {
		"@fontsource/jetbrains-mono": "^5.2.5",
